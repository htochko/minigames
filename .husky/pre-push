#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Running linter and format checks before push..."

npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed. Fix the errors before pushing."
  exit 1
fi

npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Prettier format check failed. Run 'npm run format' to fix code styling."
  exit 1
fi

echo "✅ All checks passed! Proceeding with push."